# ========================================
# FraudLens — Environment Configuration
# ========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# --- Database (PostgreSQL production, SQLite local fallback) ---
DATABASE_URL=postgresql+asyncpg://fraud_user:fraud_pass@localhost:5432/fraud_detection
DATABASE_URL_SYNC=postgresql://fraud_user:fraud_pass@localhost:5432/fraud_detection

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=fraud_detection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Application ---
APP_NAME=Fraud Detection Platform
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# --- CORS (production: set to your frontend domain) ---
CORS_ORIGINS=["https://your-app.onrender.com","https://fraudlens.example.com"]

# --- ML ---
MODELS_DIR=./models_artifacts
DEFAULT_THRESHOLD=0.5

# --- Simulation ---
SIMULATION_INTERVAL=3.0
SIMULATION_ENABLED=true

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30

# --- Logging ---
LOG_LEVEL=INFO

# ========================================
# Frontend Environment Variables
# ========================================
# Set these in Render/Vercel/Netlify dashboard or .env for local dev.
#
# Production:  VITE_API_URL=https://your-backend.onrender.com/api/v1
#              VITE_WS_URL=wss://your-backend.onrender.com
#
# Local dev:   Leave unset — Vite proxy handles /api and /ws routing.
#              The app falls back to http://localhost:8000/api/v1 automatically.
