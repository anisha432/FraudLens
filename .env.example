# ========================================
# Fraud Detection Platform - Environment
# ========================================

# Database
DATABASE_URL=postgresql+asyncpg://fraud_user:fraud_pass@localhost:5432/fraud_detection
DATABASE_URL_SYNC=postgresql://fraud_user:fraud_pass@localhost:5432/fraud_detection

# PostgreSQL
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_detection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
APP_NAME=Fraud Detection Platform
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:1420"]

# ML
MODELS_DIR=./models_artifacts
DEFAULT_THRESHOLD=0.5

# Real-time Simulation
SIMULATION_INTERVAL=3.0
SIMULATION_ENABLED=true

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Logging
LOG_LEVEL=INFO
